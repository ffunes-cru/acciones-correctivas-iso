# --- SQL Server (company instance in production) ---
DB_HOST=sqlserver.example.local
DB_PORT=1433
DB_DATABASE=acciones_iso
DB_USER=acciones_iso_app
DB_PASSWORD=

# --- Directus ---
# Generate with: openssl rand -hex 32
DIRECTUS_KEY=
DIRECTUS_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Absolute URL users type in the browser. Do not change it casually: licence activation (if any) binds to it.
PUBLIC_URL=http://localhost:8055

# --- Mail ---
EMAIL_FROM=calidad@example.com
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=25

# --- Google Sheets export (service account; replaces the legacy client OAuth sync) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Directus licence key (only if the Core tier proves insufficient, see docs/PLAN.md D1) ---
# LICENSE_KEY=
