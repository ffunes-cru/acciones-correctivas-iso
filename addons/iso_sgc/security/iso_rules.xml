<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Everybody reads everything (as in the legacy app); multi-company applies. -->
    <record id="rule_iso_finding_company" model="ir.rule">
        <field name="name">ISO finding: multi-company</field>
        <field name="model_id" ref="model_iso_finding"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Writing: only people involved in the finding. Transitions are further guarded in Python. -->
    <record id="rule_iso_finding_write_involved" model="ir.rule">
        <field name="name">ISO finding: write if involved</field>
        <field name="model_id" ref="model_iso_finding"/>
        <field name="groups" eval="[(4, ref('group_iso_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">['|', '|', ('owner_id', '=', user.id), ('analysis_user_id', '=', user.id), ('action_ids.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_iso_finding_unlink_owner" model="ir.rule">
        <field name="name">ISO finding: delete own</field>
        <field name="model_id" ref="model_iso_finding"/>
        <field name="groups" eval="[(4, ref('group_iso_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="domain_force">[('owner_id', '=', user.id)]</field>
    </record>
    <record id="rule_iso_finding_admin" model="ir.rule">
        <field name="name">ISO finding: admin all</field>
        <field name="model_id" ref="model_iso_finding"/>
        <field name="groups" eval="[(4, ref('group_iso_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_iso_finding_action_company" model="ir.rule">
        <field name="name">ISO action: multi-company</field>
        <field name="model_id" ref="model_iso_finding_action"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_iso_finding_action_write" model="ir.rule">
        <field name="name">ISO action: write if responsible or finding owner</field>
        <field name="model_id" ref="model_iso_finding_action"/>
        <field name="groups" eval="[(4, ref('group_iso_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('finding_id.owner_id', '=', user.id)]</field>
    </record>
    <record id="rule_iso_finding_action_admin" model="ir.rule">
        <field name="name">ISO action: admin all</field>
        <field name="model_id" ref="model_iso_finding_action"/>
        <field name="groups" eval="[(4, ref('group_iso_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_iso_special_release_company" model="ir.rule">
        <field name="name">ISO special release: multi-company</field>
        <field name="model_id" ref="model_iso_special_release"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_iso_special_release_write_creator" model="ir.rule">
        <field name="name">ISO special release: write own</field>
        <field name="model_id" ref="model_iso_special_release"/>
        <field name="groups" eval="[(4, ref('group_iso_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="domain_force">[('creator_id', '=', user.id)]</field>
    </record>
    <record id="rule_iso_special_release_admin" model="ir.rule">
        <field name="name">ISO special release: admin all</field>
        <field name="model_id" ref="model_iso_special_release"/>
        <field name="groups" eval="[(4, ref('group_iso_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_iso_special_release_approval_write_creator" model="ir.rule">
        <field name="name">ISO special release approval: write if release creator</field>
        <field name="model_id" ref="model_iso_special_release_approval"/>
        <field name="groups" eval="[(4, ref('group_iso_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="domain_force">[('release_id.creator_id', '=', user.id)]</field>
    </record>
    <record id="rule_iso_special_release_approval_admin" model="ir.rule">
        <field name="name">ISO special release approval: admin all</field>
        <field name="model_id" ref="model_iso_special_release_approval"/>
        <field name="groups" eval="[(4, ref('group_iso_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- ISO calendar -->
    <record id="rule_iso_calendar_company" model="ir.rule">
        <field name="name">ISO calendar: multi-company</field>
        <field name="model_id" ref="model_iso_calendar"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_iso_calendar_task_company" model="ir.rule">
        <field name="name">ISO calendar task: multi-company</field>
        <field name="model_id" ref="model_iso_calendar_task"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <!-- Audit tasks are visible only to the responsible and the people the report was shared with. -->
    <record id="rule_iso_calendar_task_read" model="ir.rule">
        <field name="name">ISO calendar task: audits only for involved users</field>
        <field name="model_id" ref="model_iso_calendar_task"/>
        <field name="groups" eval="[(4, ref('group_iso_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">['|', ('is_audit', '=', False), '|', ('user_id', '=', user.id), ('shared_user_ids', 'in', [user.id])]</field>
    </record>
    <record id="rule_iso_calendar_task_write" model="ir.rule">
        <field name="name">ISO calendar task: write own</field>
        <field name="model_id" ref="model_iso_calendar_task"/>
        <field name="groups" eval="[(4, ref('group_iso_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="rule_iso_calendar_task_admin" model="ir.rule">
        <field name="name">ISO calendar task: admin all</field>
        <field name="model_id" ref="model_iso_calendar_task"/>
        <field name="groups" eval="[(4, ref('group_iso_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_iso_audit_line_read" model="ir.rule">
        <field name="name">ISO audit line: only involved users</field>
        <field name="model_id" ref="model_iso_audit_line"/>
        <field name="groups" eval="[(4, ref('group_iso_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">['|', ('task_id.user_id', '=', user.id), ('task_id.shared_user_ids', 'in', [user.id])]</field>
    </record>
    <record id="rule_iso_audit_line_write" model="ir.rule">
        <field name="name">ISO audit line: write own</field>
        <field name="model_id" ref="model_iso_audit_line"/>
        <field name="groups" eval="[(4, ref('group_iso_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="domain_force">[('task_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_iso_audit_line_admin" model="ir.rule">
        <field name="name">ISO audit line: admin all</field>
        <field name="model_id" ref="model_iso_audit_line"/>
        <field name="groups" eval="[(4, ref('group_iso_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Change requests -->
    <record id="rule_iso_change_request_company" model="ir.rule">
        <field name="name">ISO change request: multi-company</field>
        <field name="model_id" ref="model_iso_change_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_iso_change_request_write" model="ir.rule">
        <field name="name">ISO change request: write own</field>
        <field name="model_id" ref="model_iso_change_request"/>
        <field name="groups" eval="[(4, ref('group_iso_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="domain_force">[('creator_id', '=', user.id)]</field>
    </record>
    <record id="rule_iso_change_request_admin" model="ir.rule">
        <field name="name">ISO change request: admin all</field>
        <field name="model_id" ref="model_iso_change_request"/>
        <field name="groups" eval="[(4, ref('group_iso_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_iso_change_review_write" model="ir.rule">
        <field name="name">ISO change review: write if reviewer or creator</field>
        <field name="model_id" ref="model_iso_change_review"/>
        <field name="groups" eval="[(4, ref('group_iso_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('request_id.creator_id', '=', user.id)]</field>
    </record>
    <record id="rule_iso_change_review_admin" model="ir.rule">
        <field name="name">ISO change review: admin all</field>
        <field name="model_id" ref="model_iso_change_review"/>
        <field name="groups" eval="[(4, ref('group_iso_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_iso_change_review_line_write" model="ir.rule">
        <field name="name">ISO change review line: write if reviewer</field>
        <field name="model_id" ref="model_iso_change_review_line"/>
        <field name="groups" eval="[(4, ref('group_iso_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="domain_force">[('review_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_iso_change_review_line_admin" model="ir.rule">
        <field name="name">ISO change review line: admin all</field>
        <field name="model_id" ref="model_iso_change_review_line"/>
