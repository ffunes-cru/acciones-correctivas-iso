<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ actions used by buttons (defined first) ============ -->
    <record id="action_iso_calendar_share_wizard" model="ir.actions.act_window">
        <field name="name">Share audit</field>
        <field name="res_model">iso.calendar.share.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ============ configuration ============ -->
    <record id="view_iso_audit_process_list" model="ir.ui.view">
        <field name="name">iso.audit.process.list</field>
        <field name="model">iso.audit.process</field>
        <field name="arch" type="xml">
            <list><field name="sequence" widget="handle"/><field name="name"/><field name="active" column_invisible="1"/></list>
        </field>
    </record>
    <record id="view_iso_audit_process_form" model="ir.ui.view">
        <field name="name">iso.audit.process.form</field>
        <field name="model">iso.audit.process</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><field name="name"/><field name="active"/></group>
                    <group><field name="objective"/><field name="clauses"/></group>
                    <field name="deliverable_ids">
                        <list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="description"/><field name="evidence"/></list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_iso_activity_template_list" model="ir.ui.view">
        <field name="name">iso.activity.template.list</field>
        <field name="model">iso.activity.template</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="frequency"/><field name="active"/></list>
        </field>
    </record>
    <record id="action_iso_audit_process" model="ir.actions.act_window">
        <field name="name">Audit processes</field>
        <field name="res_model">iso.audit.process</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_iso_activity_template" model="ir.actions.act_window">
        <field name="name">Routine activities</field>
        <field name="res_model">iso.activity.template</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_company_form_iso" model="ir.ui.view">
        <field name="name">res.company.form.iso</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="ISO SGC" groups="iso_sgc.group_iso_admin">
                    <group><field name="iso_audit_scope"/></group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============ calendar ============ -->
    <record id="view_iso_calendar_list" model="ir.ui.view">
        <field name="name">iso.calendar.list</field>
        <field name="model">iso.calendar</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="year" options="{'enable_formatting': false}"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="task_count"/>
                <field name="done_count"/>
                <field name="overdue_count" decoration-danger="overdue_count > 0"/>
            </list>
        </field>
    </record>
    <record id="view_iso_calendar_form" model="ir.ui.view">
        <field name="name">iso.calendar.form</field>
        <field name="model">iso.calendar</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" groups="iso_sgc.group_iso_admin"/>
                            <field name="name" groups="!iso_sgc.group_iso_admin" readonly="1"/>
                            <field name="year" readonly="id" options="{'enable_formatting': false}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="id"/>
                        </group>
                        <group>
                            <field name="task_count"/>
                            <field name="done_count"/>
                            <field name="overdue_count"/>
                        </group>
                    </group>
                    <field name="description" groups="iso_sgc.group_iso_admin"/>
                    <field name="description" groups="!iso_sgc.group_iso_admin" readonly="1"/>
                    <field name="task_ids">
                        <list create="0" decoration-danger="is_overdue" decoration-success="state == 'done'">
                            <field name="name"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="date_deadline"/>
                            <field name="state" widget="badge"/>
                            <field name="is_overdue" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_iso_calendar" model="ir.actions.act_window">
        <field name="name">Calendars</field>
        <field name="res_model">iso.calendar</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ tasks ============ -->
    <record id="view_iso_calendar_task_list" model="ir.ui.view">
        <field name="name">iso.calendar.task.list</field>
        <field name="model">iso.calendar.task</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="calendar_id" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="date_deadline"/>
                <field name="frequency" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="is_overdue" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_iso_calendar_task_form" model="ir.ui.view">
        <field name="name">iso.calendar.task.form</field>
        <field name="model">iso.calendar.task</field>
        <field name="arch" type="xml">
            <form>
                <field name="can_edit" invisible="1"/>
                <field name="is_audit" invisible="1"/>
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'not_started' or not can_edit"/>
                    <button name="action_finish" type="object" string="Finish" class="btn-primary" invisible="state == 'done' or not can_edit"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="state != 'done' or not can_edit"/>
                    <button name="action_insert_conclusion_template" type="object" string="Insert conclusion template"
                            invisible="not is_audit or state == 'done' or not can_edit"/>
                    <button name="%(action_iso_calendar_share_wizard)d" type="action" string="Share report" invisible="not is_audit or not can_edit"
                            context="{'default_task_id': id}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group string="Planning">
                            <field name="calendar_id" readonly="1"/>
                            <field name="user_id" groups="iso_sgc.group_iso_admin" readonly="state == 'done'" widget="many2one_avatar_user"/>
                            <field name="user_id" groups="!iso_sgc.group_iso_admin" readonly="1" widget="many2one_avatar_user"/>
                            <field name="date_deadline" groups="iso_sgc.group_iso_admin" readonly="state == 'done'"/>
                            <field name="date_deadline" groups="!iso_sgc.group_iso_admin" readonly="1"/>
                            <field name="frequency" readonly="1"/>
                            <field name="label" readonly="1"/>
                        </group>
                        <group string="Execution">
                            <field name="date_completed" readonly="not can_edit"/>
                            <field name="audit_process_id" readonly="1" invisible="not is_audit"/>
                            <field name="audited_personnel" readonly="not can_edit" invisible="not is_audit"/>
                            <field name="shared_user_ids" widget="many2many_tags" readonly="1" invisible="not is_audit"/>
                        </group>
                    </group>
                    <group string="Comments / audit conclusion">
                        <field name="comments" nolabel="1" readonly="not can_edit"/>
                    </group>
                    <notebook invisible="not is_audit">
                        <page string="Scope and criteria">
                            <group>
                                <field name="scope" readonly="not can_edit"/>
                                <field name="criteria" readonly="not can_edit"/>
                                <field name="strengths" readonly="not can_edit"/>
                            </group>
                        </page>
                        <page string="Opportunities and nonconformities">
                            <field name="line_ids" readonly="not can_edit">
                                <list editable="bottom">
                                    <field name="can_confirm" column_invisible="1"/>
                                    <field name="finding_id" column_invisible="1"/>
                                    <field name="kind" readonly="finding_id"/>
                                    <field name="text" readonly="finding_id"/>
                                    <field name="process" readonly="finding_id"/>
                                    <field name="user_id" readonly="finding_id" widget="many2one_avatar_user"/>
                                    <field name="date_deadline" readonly="finding_id"/>
                                    <field name="finding_id" readonly="1"/>
                                    <button name="action_confirm" type="object" string="Raise finding" icon="fa-link"
                                            invisible="not can_confirm"/>
                                </list>
                            </field>
                        </page>
                        <page string="Process checklist" invisible="not audit_process_id">
                            <group>
                                <field name="process_objective"/>
                                <field name="process_clauses"/>
                            </group>
                            <field name="process_deliverable_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="evidence"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_iso_calendar_task_search" model="ir.ui.view">
        <field name="name">iso.calendar.task.search</field>
        <field name="model">iso.calendar.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <filter name="mine" string="Mine" domain="[('user_id', '=', uid)]"/>
                <filter name="open" string="Not finished" domain="[('state', '!=', 'done')]"/>
                <filter name="overdue" string="Overdue" domain="[('state', '!=', 'done'), ('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="audits" string="Internal audits" domain="[('is_audit', '=', True)]"/>
                <group>
                    <filter name="group_calendar" string="Calendar" context="{'group_by': 'calendar_id'}"/>
                    <filter name="group_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_iso_calendar_task_mine" model="ir.actions.act_window">
        <field name="name">My planned tasks</field>
        <field name="res_model">iso.calendar.task</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_mine': 1, 'search_default_open': 1}</field>
    </record>

    <!-- ============ wizards ============ -->
    <record id="view_iso_calendar_wizard_form" model="ir.ui.view">
        <field name="name">iso.calendar.wizard.form</field>
        <field name="model">iso.calendar.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="year" options="{'enable_formatting': false}"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="global_auditor_id" placeholder="Choose a user to fill every audit…"/>
                        <field name="global_responsible_id" placeholder="Choose a user to fill every activity…"/>
                    </group>
                </group>
                <field name="description" placeholder="Description (optional)"/>
                <notebook>
                    <page string="Internal audits">
                        <field name="audit_line_ids">
                            <list editable="bottom" create="0">
                                <field name="process_id" readonly="1" force_save="1"/>
                                <field name="quarter" readonly="1" force_save="1"/>
                                <field name="date"/>
                                <field name="user_id"/>
                            </list>
                        </field>
                    </page>
                    <page string="Routine activities">
                        <field name="activity_line_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="frequency"/>
                                <field name="user_id"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_create" type="object" string="Create planning" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_iso_calendar_wizard" model="ir.actions.act_window">
        <field name="name">Create annual planning</field>
        <field name="res_model">iso.calendar.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_iso_calendar_share_wizard_form" model="ir.ui.view">
        <field name="name">iso.calendar.share.wizard.form</field>
        <field name="model">iso.calendar.share.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="task_id" invisible="1"/>
                    <field name="user_ids" widget="many2many_tags"/>
                    <field name="extra_emails"/>
                    <field name="message"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Share" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
