<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_iso_change_line_action_wizard" model="ir.actions.act_window">
        <field name="name">Create action</field>
        <field name="res_model">iso.change.line.action.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_iso_change_line_action_wizard_form" model="ir.ui.view">
        <field name="name">iso.change.line.action.wizard.form</field>
        <field name="model">iso.change.line.action.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="line_id" invisible="1"/>
                    <field name="description"/>
                    <field name="user_id" widget="many2one_avatar_user"/>
                    <field name="date_deadline"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Create action" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- configuration: areas and their questionnaires -->
    <record id="view_iso_change_area_list" model="ir.ui.view">
        <field name="name">iso.change.area.list</field>
        <field name="model">iso.change.area</field>
        <field name="arch" type="xml">
            <list><field name="sequence" widget="handle"/><field name="name"/><field name="active" column_invisible="1"/></list>
        </field>
    </record>
    <record id="view_iso_change_area_form" model="ir.ui.view">
        <field name="name">iso.change.area.form</field>
        <field name="model">iso.change.area</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><field name="name"/><field name="code"/><field name="active"/></group>
                    <field name="question_ids">
                        <list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="active"/></list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_iso_change_area" model="ir.actions.act_window">
        <field name="name">Change request areas</field>
        <field name="res_model">iso.change.area</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- one sector review: the reviewer's questionnaire -->
    <record id="view_iso_change_review_form" model="ir.ui.view">
        <field name="name">iso.change.review.form</field>
        <field name="model">iso.change.review</field>
        <field name="arch" type="xml">
            <form>
                <field name="can_decide" invisible="1"/>
                <field name="request_state" invisible="1"/>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-success" invisible="not can_decide"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger" invisible="not can_decide"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h2><field name="area_id" readonly="1"/></h2>
                    <group>
                        <field name="user_id" widget="many2one_avatar_user" groups="iso_sgc.group_iso_admin"/>
                        <field name="user_id" widget="many2one_avatar_user" groups="!iso_sgc.group_iso_admin" readonly="1"/>
                        <field name="date_deadline"/>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="not can_decide">
                        Answer every question. For each <b>Applies: Yes</b> say whether it <b>requires an action</b>; then create
                        the action with the button on its row. You can approve once everything is answered.
                    </div>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" column_invisible="1"/>
                            <field name="finding_id" column_invisible="1"/>
                            <field name="name" readonly="1"/>
                            <field name="applies" readonly="not parent.can_decide or finding_id"/>
                            <field name="requires_action" readonly="not parent.can_decide or applies != 'yes' or finding_id"/>
                            <field name="finding_id" readonly="1"/>
                            <field name="can_link" column_invisible="1"/>
                            <button name="%(action_iso_change_line_action_wizard)d" type="action" string="Create action"
                                    icon="fa-plus-circle" invisible="not can_link" context="{'default_line_id': id}"/>
                            <button name="action_remove_action" type="object" string="Remove action" icon="fa-trash"
                                    invisible="not finding_id" confirm="Delete the linked action?"
                                    groups="iso_sgc.group_iso_user"/>
                        </list>
                    </field>
                    <group>
                        <field name="comments" readonly="not can_decide"/>
                        <field name="action_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_iso_change_request_list" model="ir.ui.view">
        <field name="name">iso.change.request.list</field>
        <field name="model">iso.change.request</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'rejected'" decoration-success="state == 'approved'" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="title"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="mission" optional="show"/>
                <field name="creator_id" widget="many2one_avatar_user"/>
                <field name="pending_review_count" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_iso_change_request_form" model="ir.ui.view">
        <field name="name">iso.change.request.form</field>
        <field name="model">iso.change.request</field>
        <field name="arch" type="xml">
            <form>
                <field name="can_edit_definition" invisible="1"/>
                <field name="can_send_final" invisible="1"/>
                <field name="can_decide_final" invisible="1"/>
                <header>
                    <button name="action_send_to_review" type="object" string="Send to review" class="btn-primary"
                            invisible="not can_edit_definition"/>
                    <button name="action_send_to_final_approval" type="object" string="Send to final approval" class="btn-primary"
                            invisible="not can_send_final"/>
                    <button name="action_final_approve" type="object" string="Approve" class="btn-success" invisible="not can_decide_final"/>
                    <button name="action_final_reject" type="object" string="Reject" class="btn-danger" invisible="not can_decide_final"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending_review,pending_approval,approved"/>
                </header>
                <sheet>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <field name="title" readonly="not can_edit_definition" placeholder="e.g. New welding jig on the Fertec line"/>
                    </group>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="not can_edit_definition"/>
                            <field name="mission" readonly="not can_edit_definition"/>
                        </group>
                        <group>
                            <field name="creator_id" widget="many2one_avatar_user" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Proposal" name="proposal">
                            <group>
                                <field name="description" readonly="not can_edit_definition"/>
                                <field name="objective" readonly="not can_edit_definition"/>
                            </group>
                            <group string="Comparison">
                                <field name="current_situation" readonly="not can_edit_definition"/>
                                <field name="proposed_situation" readonly="not can_edit_definition"/>
                            </group>
                            <group>
                                <field name="impact_analysis" readonly="not can_edit_definition"/>
                            </group>
                        </page>
                        <page string="Sector reviews" name="reviews">
                            <group invisible="state != 'draft'">
                                <field name="review_deadline" readonly="not can_edit_definition"/>
                            </group>
                            <div class="text-muted" invisible="state != 'draft'">
                                Tick the areas that must review this change and choose who reviews each. Areas left unticked are approved automatically.
                            </div>
                            <field name="review_ids" readonly="state != 'draft' or not can_edit_definition">
                                <list create="0" delete="0" editable="bottom" decoration-success="state == 'approved' and applies"
                                      decoration-danger="state == 'rejected'" decoration-muted="not applies">
                                    <field name="area_id" readonly="1"/>
                                    <field name="applies" widget="boolean_toggle"/>
                                    <field name="user_id" widget="many2one_avatar_user" readonly="not applies"/>
                                    <field name="date_deadline" readonly="1"/>
                                    <field name="state" widget="badge" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Final approval" name="final" invisible="state in ('draft', 'pending_review')">
                            <group>
                                <group>
                                    <field name="final_approver_id" widget="many2one_avatar_user" readonly="not can_send_final"/>
                                    <field name="final_deadline" readonly="not can_send_final"/>
                                </group>
                                <group>
                                    <field name="final_state"/>
                                    <field name="final_date"/>
                                </group>
                            </group>
                            <group>
                                <field name="final_comments" readonly="not can_decide_final"/>
                            </group>
                        </page>
                        <page string="Communication" name="communication" invisible="not communication_sent">
                            <group>
                                <field name="communication_sent"/>
                                <field name="communication_date"/>
                                <field name="communication_notes"/>
                            </group>
                        </page>
                        <page string="Linked actions" name="actions" invisible="not linked_finding_ids">
                            <field name="linked_finding_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="state" widget="badge"/>
                                    <field name="pending_user_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_iso_change_request_search" model="ir.ui.view">
        <field name="name">iso.change.request.search</field>
        <field name="model">iso.change.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <filter name="mine" string="My requests" domain="[('creator_id', '=', uid)]"/>
                <filter name="to_review" string="Waiting for my review"
                        domain="[('state', '=', 'pending_review'), ('review_ids', 'any', [('user_id', '=', uid), ('state', '=', 'pending'), ('applies', '=', True)])]"/>
                <filter name="to_decide" string="Waiting for my final decision"
                        domain="[('state', '=', 'pending_approval'), ('final_approver_id', '=', uid), ('final_state', '=', 'pending')]"/>
                <separator/>
                <filter name="open" string="Open" domain="[('state', 'in', ('draft', 'pending_review', 'pending_approval'))]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_mission" string="Mission" context="{'group_by': 'mission'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_iso_change_request" model="ir.actions.act_window">
        <field name="name">Change requests</field>
        <field name="res_model">iso.change.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
